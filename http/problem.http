Content-Type: application/json

{
  "problemId": 2,
  "userId": 1,
  "userAnswers": [
    "1",
    "2"
  ]
}

###
# @name 문제 제출 - 복수 정답 부분 정답 (정답+오답 혼합)
POST {{baseUrl}}/api/v1/problems/submit
Content-Type: application/json

{
  "problemId": 2,
  "userId": 1,
  "userAnswers": [
    "1",
    "3"
